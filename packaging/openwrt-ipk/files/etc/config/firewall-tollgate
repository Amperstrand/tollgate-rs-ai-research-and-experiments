# Firewall rules for TollGate, pulled in via the UCI include registered by
# /etc/uci-defaults/90-tollgate-firewall (firewall.tollgate include).
#
# These accept inbound traffic to the TollGate HTTP/WS transport from the LAN.
# The WAN-side rule (optional) is added by the same uci-defaults script.

config rule
	option name 'Allow-TollGate-In'
	option src 'lan'
	option proto 'tcp'
	option dest_port '4747'
	option target 'ACCEPT'

config rule
	option name 'Allow-TollGate-In-IPv6'
	option src 'lan'
	option family 'ipv6'
	option proto 'tcp'
	option dest_port '4747'
	option target 'ACCEPT'
