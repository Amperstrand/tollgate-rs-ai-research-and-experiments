#!/bin/sh
# ============================================================================
# tollgate-setup-ssl — Configure HTTPS for TollGate
# ============================================================================
#
# WHAT: Sets up TLS certificates for the uhttpd web server. Supports
#       self-signed certificates (via uhttpd defaults) or custom certificates
#       provided via --cert/--key arguments.
#
# Go v1 REFERENCE: /packaging/files/usr/sbin/tollgate-setup-ssl
#   - 107 lines, supports self-signed and custom cert modes
#   - Configures uhttpd HTTPS listener on port 443
#   - Adds WAN firewall rule for port 443
#   - Adds NoDogSplash allow rule for port 443
#
# Rust DIFFERENCE: Nearly identical logic. The SSL setup is infrastructure-
#   level configuration, not language-specific. The only change is the
#   log tag (tollgate-setup-ssl vs tollgate-setup-ssl-rs) to distinguish
#   Rust router logs from Go v1 router logs.
#
# USAGE:
#   tollgate-setup-ssl                    # Self-signed cert via uhttpd defaults
#   tollgate-setup-ssl --cert X --key Y   # Custom certificate
# ============================================================================

SELF_SIGNED=1
CERT_FILE=""
KEY_FILE=""

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        --cert)
            CERT_FILE="${2:?--cert requires a path}"
            shift 2
            SELF_SIGNED=0
            ;;
        --key)
            KEY_FILE="${2:?--key requires a path}"
            shift 2
            ;;
        -h|--help)
            echo "Usage: tollgate-setup-ssl [--cert <path> --key <path>]"
            echo "  No args  — generate self-signed cert via uhttpd defaults"
            echo "  --cert/--key — use custom certificate and key"
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

logger -t tollgate-setup-ssl "Starting SSL setup (mode: $([ "$SELF_SIGNED" -eq 1 ] && echo 'self-signed' || echo 'custom'))"

# ---------------------------------------------------------------------------
# Self-signed certificate generation
# ---------------------------------------------------------------------------
if [ "$SELF_SIGNED" -eq 1 ]; then
    # Use uhttpd's built-in cert generation if defaults script exists
    if [ -x /etc/init.d/uhttpd ]; then
        # uhttpd defaults script generates self-signed certs
        # if they don't already exist
        if [ ! -f /etc/uhttpd.crt ] || [ ! -f /etc/uhttpd.key ]; then
            logger -t tollgate-setup-ssl "Generating self-signed certificate via uhttpd defaults"
            /etc/init.d/uhttpd defaults 2>/dev/null || {
                echo "Warning: uhttpd defaults failed, attempting manual cert generation" >&2
                # Fallback: generate cert manually with openssl
                if command -v openssl >/dev/null 2>&1; then
                    openssl req -x509 -newkey rsa:2048 -keyout /etc/uhttpd.key \
                        -out /etc/uhttpd.crt -days 365 -nodes \
                        -subj "/CN=TollGate-Rust" 2>/dev/null
                    logger -t tollgate-setup-ssl "Generated self-signed cert via openssl fallback"
                else
                    echo "Error: No openssl available for cert generation" >&2
                    exit 1
                fi
            }
        else
            logger -t tollgate-setup-ssl "Existing self-signed certs found, reusing"
        fi
    else
        echo "Error: uhttpd not installed" >&2
        exit 1
    fi

    CERT_FILE="/etc/uhttpd.crt"
    KEY_FILE="/etc/uhttpd.key"
else
    # Custom cert mode — verify files exist
    if [ ! -f "$CERT_FILE" ]; then
        echo "Error: Certificate file not found: $CERT_FILE" >&2
        exit 1
    fi
    if [ ! -f "$KEY_FILE" ]; then
        echo "Error: Key file not found: $KEY_FILE" >&2
        exit 1
    fi

    # Copy to uhttpd expected locations (idempotent)
    cp "$CERT_FILE" /etc/uhttpd.crt
    cp "$KEY_FILE" /etc/uhttpd.key
    logger -t tollgate-setup-ssl "Installed custom certificate from $CERT_FILE"
fi

# Verify cert and key exist
if [ ! -f /etc/uhttpd.crt ] || [ ! -f /etc/uhttpd.key ]; then
    echo "Error: Certificate or key file missing after setup" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Configure uhttpd HTTPS listener
# ---------------------------------------------------------------------------
uci set uhttpd.main.listen_https='0.0.0.0:443'
uci set uhttpd.main.listen_https='[::]:443'
uci set uhttpd.main.cert='/etc/uhttpd.crt'
uci set uhttpd.main.key='/etc/uhttpd.key'
logger -t tollgate-setup-ssl "Configured uhttpd HTTPS on port 443"

# ---------------------------------------------------------------------------
# Add WAN firewall rule for port 443 (idempotent)
# ---------------------------------------------------------------------------
FOUND_443=0
for i in $(seq 0 20); do
    if uci -q get "firewall.@rule[${i}].name" | grep -q "Allow-HTTPS-WAN" 2>/dev/null; then
        FOUND_443=1
        break
    fi
done

if [ "$FOUND_443" -eq 0 ]; then
    uci add firewall rule
    uci set firewall.@rule[-1].name='Allow-HTTPS-WAN'
    uci set firewall.@rule[-1].src='wan'
    uci set firewall.@rule[-1].proto='tcp'
    uci set firewall.@rule[-1].dest_port='443'
    uci set firewall.@rule[-1].target='ACCEPT'
    logger -t tollgate-setup-ssl "Added WAN firewall rule for port 443"
else
    logger -t tollgate-setup-ssl "WAN firewall rule for port 443 already exists"
fi

# ---------------------------------------------------------------------------
# Add NoDogSplash allow rule for port 443 (if nodogsplash is installed)
# ---------------------------------------------------------------------------
if command -v nodogsplash >/dev/null 2>&1; then
    # Check if port 443 already in allow rules
    PORTS_LIST="$(uci -q get nodogsplash.@nodogsplash[0].fw_allow_ports 2>/dev/null)"
    case "$PORTS_LIST" in
        *443*)
            logger -t tollgate-setup-ssl "NoDogSplash already allows port 443"
            ;;
        *)
            uci -q add_list nodogsplash.@nodogsplash[0].fw_allow_ports="tcp:443" 2>/dev/null || true
            logger -t tollgate-setup-ssl "Added NoDogSplash allow rule for port 443"
            ;;
    esac
fi

# Commit and restart
uci commit
/etc/init.d/uhttpd restart 2>/dev/null || true
/etc/init.d/firewall reload 2>/dev/null || true
command -v nodogsplash >/dev/null 2>&1 && \
    /etc/init.d/nodogsplash restart 2>/dev/null || true

logger -t tollgate-setup-ssl "SSL setup complete"
echo "SSL setup complete. HTTPS enabled on port 443."

exit 0
