#!/bin/sh
# ============================================================================
# 99-tollgate-setup — First-boot system configuration for TollGate Rust
# ============================================================================
#
# WHAT: OpenWrt uci-defaults script that runs once on first boot after
#       package installation. Configures firewall, HTTP server, DNS,
#       hostname, WiFi APs, captive portal, and private network.
#
# Go v1 REFERENCE: /packaging/files/etc/uci-defaults/99-tollgate-setup
#   - 286 lines, 9 setup functions
#   - Configures: firewall include, uhttpd, DNS, hostname, public WiFi,
#     nodogsplash, firewall rules, modems, private network
#   - Uses sequential function calls, no step indicators
#
# Rust IMPROVEMENTS over Go v1:
#   1. Adds relay port 4242 to WAN firewall rules (Rust has relay, Go doesn't)
#   2. Step indicators [1/10]..[10/10] in logs for debugging
#   3. Gateway name includes "Rust" to distinguish from Go v1 deployments
#   4. Better logging via logger(1) alongside echo
#   5. Explicit idempotency guards (check before set, skip if already configured)
#   6. POSIX sh compatible — no bashisms (runs on BusyBox ash)
#
# UCI-DEFAULTS CONVENTION: This script runs once, then deletes itself.
# Safe to call multiple times (idempotent) in case of partial failure.
# ============================================================================

set -e

TOTAL_STEPS=10
STEP=0

step_start() {
    STEP=$((STEP + 1))
    printf "[ %d / %d ] %s\n" "$STEP" "$TOTAL_STEPS" "$1"
    logger -t tollgate-setup "[%d/%d] %s" "$STEP" "$TOTAL_STEPS" "$1"
}

# ---------------------------------------------------------------------------
# 1. Firewall include — pull in /etc/config/firewall-tollgate
# ---------------------------------------------------------------------------
setup_firewall_include() {
    step_start "Setting up firewall include for firewall-tollgate"

    # Idempotent: check if include already exists
    if uci -q get firewall.tollgate >/dev/null 2>&1; then
        echo "  Firewall include already exists, skipping."
        return 0
    fi

    uci set firewall.tollgate=include
    uci set firewall.tollgate.path='/etc/config/firewall-tollgate'
    # Go v1 uses type 'script' but we use the config file directly
    uci set firewall.tollgate.type='uci'
    uci set firewall.tollgate.reload='1'

    logger -t tollgate-setup "Added firewall include for firewall-tollgate"
}

# ---------------------------------------------------------------------------
# 2. uhttpd — configure HTTP on port 8080, HTTPS on 443 if certs exist
# ---------------------------------------------------------------------------
setup_uhttpd() {
    step_start "Configuring uhttpd (HTTP :8080)"

    # Idempotent: only set if not already configured
    cur_port="$(uci -q get uhttpd.main.listen_http)"
    case "$cur_port" in
        *8080*)
            echo "  uhttpd HTTP already on 8080, skipping."
            ;;
        *)
            uci set uhttpd.main.listen_http='0.0.0.0:8080'
            uci set uhttpd.main.listen_http='[::]:8080'
            logger -t tollgate-setup "Set uhttpd HTTP to port 8080"
            ;;
    esac

    # HTTPS on 443 if certificates exist
    if [ -f "/etc/tollgate/cert.pem" ] && [ -f "/etc/tollgate/key.pem" ]; then
        cur_https="$(uci -q get uhttpd.main.listen_https)"
        case "$cur_https" in
            *443*)
                echo "  uhttpd HTTPS already on 443, skipping."
                ;;
            *)
                uci set uhttpd.main.listen_https='0.0.0.0:443'
                uci set uhttpd.main.listen_https='[::]:443'
                uci set uhttpd.main.cert='/etc/tollgate/cert.pem'
                uci set uhttpd.main.key='/etc/tollgate/key.pem'
                logger -t tollgate-setup "Configured uhttpd HTTPS on port 443"
                ;;
        esac
    else
        echo "  No TLS certs found in /etc/tollgate/, HTTPS not configured."
    fi
}

# ---------------------------------------------------------------------------
# 3. DNS — set Cloudflare 1.1.1.1 if DNS is unset or localhost
# ---------------------------------------------------------------------------
setup_dns_dnsmasq() {
    step_start "Configuring DNS (Cloudflare 1.1.1.1 fallback)"

    cur_dns="$(uci -q get network.wan.dns)"
    case "$cur_dns" in
        ""|127.0.0.1|localhost)
            uci set network.wan.peerdns='0'
            uci del network.wan.dns 2>/dev/null || true
            uci add_list network.wan.dns='1.1.1.1'
            uci add_list network.wan.dns='1.0.0.1'
            logger -t tollgate-setup "Set DNS to Cloudflare 1.1.1.1 / 1.0.0.1"
            ;;
        *)
            echo "  DNS already configured ($cur_dns), skipping."
            ;;
    esac
}

# ---------------------------------------------------------------------------
# 4. Hostname — change from OpenWrt to TollGate-Rust
# ---------------------------------------------------------------------------
setup_hostname() {
    step_start "Setting hostname"

    cur_hostname="$(uci -q get system.@system[0].hostname)"
    case "$cur_hostname" in
        TollGate*)
            echo "  Hostname already set to '$cur_hostname', skipping."
            ;;
        *)
            # Rust IMPROVEMENT: Include "Rust" in hostname to distinguish
            # from Go v1 deployments on the same network
            uci set system.@system[0].hostname='TollGate-Rust'
            uci set system.@system[0].zonename='UTC'
            uci set system.@system[0].timezone='UTC0'
            logger -t tollgate-setup "Set hostname to TollGate-Rust"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# 5. Public WiFi — open AP with random SSID "TollGate-XXXX"
# ---------------------------------------------------------------------------
setup_public_wifi() {
    step_start "Setting up public WiFi AP"

    # Generate random 4-hex-char suffix (BusyBox compatible)
    RAND_HEX="$(hexdump -n 2 -e '2/1 "%02x"' /dev/urandom 2>/dev/null || \
                head -c 4 /dev/urandom | od -A n -t x1 | tr -d ' \n' | head -c 4)"

    # Check if public wifi already configured
    if uci -q get wireless.public >/dev/null 2>&1; then
        echo "  Public WiFi already configured, skipping."
        return 0
    fi

    # Find first radio (typically radio0 for 2.4GHz)
    RADIO="$(uci -q get wireless.@wifi-device[0] | head -1)"
    if [ -z "$RADIO" ]; then
        # Try radio0 directly
        if uci -q get wireless.radio0 >/dev/null 2>&1; then
            RADIO="radio0"
        else
            echo "  No wifi device found, skipping public WiFi."
            return 0
        fi
    fi

    # Add public wifi-iface
    uci add wireless wifi-iface
    uci set wireless.@wifi-iface[-1].device="$RADIO"
    uci set wireless.@wifi-iface[-1].mode='ap'
    uci set wireless.@wifi-iface[-1].ssid="TollGate-${RAND_HEX}"
    uci set wireless.@wifi-iface[-1].encryption='none'
    uci set wireless.@wifi-iface[-1].network='lan'
    uci set wireless.@wifi-iface[-1].isolate='1'

    logger -t tollgate-setup "Created public WiFi AP: TollGate-${RAND_HEX}"
}

# ---------------------------------------------------------------------------
# 6. NoDogSplash — captive portal with allow rules
# ---------------------------------------------------------------------------
setup_nodogsplash() {
    step_start "Configuring NoDogSplash captive portal"

    if ! command -v nodogsplash >/dev/null 2>&1; then
        echo "  NoDogSplash not installed, skipping."
        return 0
    fi

    # Idempotent: only configure if not already set
    if uci -q get nodogsplash.@nodogsplash[0].gatewayname >/dev/null 2>&1; then
        echo "  NoDogSplash already configured, skipping."
        return 0
    fi

    uci set nodogsplash.@nodogsplash[0].gatewayname='TollGate Rust - Pay per byte'
    uci set nodogsplash.@nodogsplash[0].gatewayinterface='br-lan'
    uci set nodogsplash.@nodogsplash[0].enabled='1'
    uci set nodogsplash.@nodogsplash[0].preauthidletimeout='30'
    uci set nodogsplash.@nodogsplash[0].authidletimeout='480'
    uci set nodogsplash.@nodogsplash[0].clienttimeout='300'

    # Allow rules: TollGate ports must be accessible through the captive portal
    # Go v1: 2121 (API), 8080 (HTTP), 2050 (NoDogSplash itself)
    # Rust:  + 4242 (relay port — Rust has relay, Go doesn't)
    if [ -f /etc/nodogsplash/nds.ini ]; then
        NDS_CONF="/etc/nodogsplash/nds.ini"
    else
        NDS_CONF="/etc/config/nodogsplash"
    fi

    # Add FirewallRuleSet allow rules if not already present
    # These go into /etc/nodogsplash/nds.conf or via UCI
    for port in 2121 4242 8080 2050; do
        uci -q add_list nodogsplash.@nodogsplash[0].fw_allow_ports="tcp:${port}" 2>/dev/null || true
    done

    uci set nodogsplash.@nodogsplash[0].enabled='1'

    logger -t tollgate-setup "Configured NoDogSplash with allow rules (2121, 4242, 8080, 2050)"
}

# ---------------------------------------------------------------------------
# 7. Firewall rules — WAN→router for TollGate ports
# ---------------------------------------------------------------------------
setup_tollgate_firewall_rules() {
    step_start "Setting up WAN firewall rules for TollGate ports"

    # Go v1: only port 2121
    # Rust: ports 2121 (API) + 4242 (relay)
    RULES_CONFIGURED=0

    for PORT in 2121 4242; do
        # Idempotent: check if rule already exists
        RULE_NAME="Allow-TollGate-WAN-${PORT}"
        FOUND=0
        for i in $(seq 0 20); do
            if uci -q get "firewall.@rule[${i}].name" | grep -q "$RULE_NAME" 2>/dev/null; then
                FOUND=1
                break
            fi
        done

        if [ "$FOUND" -eq 1 ]; then
            echo "  Firewall rule for port ${PORT} already exists, skipping."
            continue
        fi

        uci add firewall rule
        uci set firewall.@rule[-1].name="$RULE_NAME"
        uci set firewall.@rule[-1].src='wan'
        uci set firewall.@rule[-1].proto='tcp'
        uci set firewall.@rule[-1].dest_port="$PORT"
        uci set firewall.@rule[-1].target='ACCEPT'
        RULES_CONFIGURED=$((RULES_CONFIGURED + 1))
    done

    [ "$RULES_CONFIGURED" -gt 0 ] && \
        logger -t tollgate-setup "Added ${RULES_CONFIGURED} WAN firewall rules (ports 2121, 4242)"
}

# ---------------------------------------------------------------------------
# 8. Profile hook — first-login setup indicator
# ---------------------------------------------------------------------------
setup_profile_hook() {
    step_start "Setting up profile hook for first-login"

    HOOK_LINE="[ -f /etc/tollgate/first-login-setup ] && sh /etc/tollgate/first-login-setup"

    # Idempotent: only add if not already present
    if grep -q "tollgate" /etc/profile 2>/dev/null; then
        echo "  Profile hook already present, skipping."
        return 0
    fi

    printf '%s\n' "$HOOK_LINE" >> /etc/profile
    touch /etc/tollgate/first-login-setup 2>/dev/null || true
    logger -t tollgate-setup "Added profile hook to /etc/profile"
}

# ---------------------------------------------------------------------------
# 9. Modems — enable any modem_ sections in UCI
# ---------------------------------------------------------------------------
enable_modems() {
    step_start "Enabling modem interfaces"

    MODEM_COUNT=0
    for section in $(uci -q show network | grep "=interface" | cut -d. -f2 | cut -d= -f1); do
        case "$section" in
            modem_*)
                uci set "network.${section}.auto='1'"
                MODEM_COUNT=$((MODEM_COUNT + 1))
                ;;
        esac
    done

    if [ "$MODEM_COUNT" -gt 0 ]; then
        logger -t tollgate-setup "Enabled ${MODEM_COUNT} modem interface(s)"
    else
        echo "  No modem interfaces found."
    fi
}

# ---------------------------------------------------------------------------
# 10. Private network — encrypted WiFi AP on adjacent /24
# ---------------------------------------------------------------------------
setup_private_network() {
    step_start "Setting up private network (encrypted AP)"

    # Idempotent: check if private interface already exists
    if uci -q get network.private >/dev/null 2>&1; then
        echo "  Private network already configured, skipping."
        return 0
    fi

    # Create private interface
    uci set network.private=interface
    uci set network.private.proto='static'
    uci set network.private.ipaddr='192.168.2.1'
    uci set network.private.netmask='255.255.255.0'

    # Create private WiFi AP (encrypted)
    RAND_KEY="$(hexdump -n 8 -e '8/1 "%02x"' /dev/urandom 2>/dev/null || \
                head -c 16 /dev/urandom | od -A n -t x1 | tr -d ' \n' | head -c 16)"

    RADIO=""
    if uci -q get wireless.radio0 >/dev/null 2>&1; then
        RADIO="radio0"
    elif uci -q get wireless.@wifi-device[0] >/dev/null 2>&1; then
        RADIO="$(uci get wireless.@wifi-device[0])"
    fi

    if [ -z "$RADIO" ]; then
        echo "  No wifi device found, skipping private WiFi."
        return 0
    fi

    uci add wireless wifi-iface
    uci set wireless.@wifi-iface[-1].device="$RADIO"
    uci set wireless.@wifi-iface[-1].mode='ap'
    uci set wireless.@wifi-iface[-1].ssid='TollGate-Rust-Private'
    uci set wireless.@wifi-iface[-1].encryption='psk2'
    uci set wireless.@wifi-iface[-1].key="TG${RAND_KEY}"
    uci set wireless.@wifi-iface[-1].network='private'

    # Create private firewall zone
    uci set firewall.private=zone
    uci set firewall.private.name='private'
    uci set firewall.private.input='ACCEPT'
    uci set firewall.private.output='ACCEPT'
    uci set firewall.private.forward='REJECT'
    uci set firewall.private.network='private'

    # Allow private → WAN forwarding
    uci add firewall forwarding
    uci set firewall.@forwarding[-1].src='private'
    uci set firewall.@forwarding[-1].dest='wan'

    logger -t tollgate-setup "Created private network 192.168.2.0/24 with encrypted WiFi"
}

# ---------------------------------------------------------------------------
# Commit all changes
# ---------------------------------------------------------------------------
commit_all() {
    step_start "Committing UCI changes"
    uci commit
    logger -t tollgate-setup "All UCI changes committed"
}

# ============================================================================
# Main execution
# ============================================================================

echo "========================================"
echo " TollGate Rust — First-boot Setup"
echo " $(date)"
echo "========================================"

mkdir -p /etc/tollgate

setup_firewall_include
setup_uhttpd
setup_dns_dnsmasq
setup_hostname
setup_public_wifi
setup_nodogsplash
setup_tollgate_firewall_rules
setup_profile_hook
enable_modems
setup_private_network
commit_all

echo "========================================"
echo " TollGate Rust setup complete."
echo "========================================"

logger -t tollgate-setup "TollGate Rust first-boot setup completed successfully"

exit 0
