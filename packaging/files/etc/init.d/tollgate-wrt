#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Check service status"

start_service() {
    # Determine valve mode: use NDS if nodogsplash is installed
    VALVE_MODE="stub"
    if command -v ndsctl >/dev/null 2>&1; then
        VALVE_MODE="nds"
    fi

    procd_open_instance
    procd_set_param command /usr/bin/tollgate-wrt server \
        --port "$(uci_get tollgate_wrt @server[0] port 2121)" \
        --metric "$(uci_get tollgate_wrt @server[0] metric bytes)" \
        --step-size "$(uci_get tollgate_wrt @server[0] step_size 5000)" \
        --valve "$VALVE_MODE"
    procd_set_param depends nodogsplash
    procd_set_param respawn 3 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    # Log the start for debugging
    echo "TollGate started with valve=$VALVE_MODE" > /tmp/tollgate-start.log
}

stop() {
    echo "TollGate stopped" >> /tmp/tollgate-start.log
}

status() {
    if pgrep -f "tollgate-wrt" >/dev/null; then
        echo "tollgate-wrt is running"
        nds_status=$(/etc/init.d/nodogsplash status 2>/dev/null || echo "not installed")
        echo "NoDogSplash: $nds_status"
        return 0
    else
        echo "tollgate-wrt is not running"
        return 1
    fi
}
