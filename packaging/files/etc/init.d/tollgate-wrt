#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

EXTRA_COMMANDS="status"
EXTRA_HELP="        status          Check service status"

start_service() {
    mkdir -p /etc/tollgate /var/lib/tollgate

    # Enable route_localnet so DNAT to 127.0.0.1:2121 works for captive portal
    echo 1 > /proc/sys/net/ipv4/conf/all/route_localnet 2>/dev/null || true

    # Accept port 2121 and 80 in iptables (nodogsplash's ndsRTR chain blocks them otherwise)
    iptables -C INPUT -p tcp --dport 2121 -j ACCEPT 2>/dev/null || iptables -I INPUT 1 -p tcp --dport 2121 -j ACCEPT
    iptables -C INPUT -p tcp --dport 80 -j ACCEPT 2>/dev/null || iptables -I INPUT 1 -p tcp --dport 80 -j ACCEPT

    procd_open_instance
    procd_set_param command /usr/bin/tollgate-wrt
    procd_set_param directory /
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /tmp/tollgate-debug.log
    procd_set_param respawn 3 5 0
    procd_close_instance
}

status() {
    if pgrep -f "tollgate-wrt" >/dev/null; then
        echo "TollGate is running"
        curl -s -o /dev/null -w "Backend HTTP: %{http_code}\n" http://127.0.0.1:2121/ 2>/dev/null || echo "Backend HTTP: unreachable"
        return 0
    else
        echo "TollGate is not running"
        return 1
    fi
}
