#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Check service status"

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/tollgate-wrt server \
        --port "$(uci_get tollgate_wrt @server[0] port 2121)" \
        --metric "$(uci_get tollgate_wrt @server[0] metric bytes)" \
        --step-size "$(uci_get tollgate_wrt @server[0] step_size 5000)"
    procd_set_param respawn 3 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

status() {
    if pgrep -f "tollgate-wrt" >/dev/null; then
        echo "tollgate-wrt is running"
        return 0
    else
        echo "tollgate-wrt is not running"
        return 1
    fi
}
