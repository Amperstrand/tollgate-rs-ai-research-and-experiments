#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

EXTRA_COMMANDS="status"
EXTRA_HELP="        status          Check service status"

start_service() {
    mkdir -p /etc/tollgate /var/lib/tollgate

    # Build args from /etc/tollgate/config.json (Go v1 compat format)
    CONFIG_FILE="/etc/tollgate/config.json"
    MINT_ARGS=""

    if [ -f "$CONFIG_FILE" ] && command -v jq >/dev/null 2>&1; then
        MINTS=$(jq -r '.accepted_mints[].url // empty' "$CONFIG_FILE" 2>/dev/null)
        for mint in $MINTS; do
            MINT_ARGS="$MINT_ARGS --mint $mint"
        done
    fi

    # Fallback if no config or no mints found
    if [ -z "$MINT_ARGS" ]; then
        MINT_ARGS="--mint https://testnut.cashu.exchange"
    fi

    echo "Starting tollgate v1-serve $MINT_ARGS" > /tmp/tollgate-start.log

    procd_open_instance
    procd_set_param command /usr/bin/tollgate v1-serve $MINT_ARGS
    procd_set_param directory /
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /tmp/tollgate-debug.log
    procd_set_param respawn 3 5 0
    procd_close_instance
}

status() {
    if pgrep -f "tollgate v1-serve" >/dev/null; then
        echo "TollGate is running"
        curl -s -o /dev/null -w "Backend HTTP: %{http_code}\n" http://127.0.0.1:2121/ 2>/dev/null || echo "Backend HTTP: unreachable"
        return 0
    else
        echo "TollGate is not running"
        return 1
    fi
}
